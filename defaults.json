{
  "version": 3,
  "profiles": {
    "default": {
      "path": "$values.single.path",
      "output": "$values.single.output"
    },
    "best": {
      "path": "$values.single.path",
      "output": "$values.single.output",
      "resolution": "best"
    },
    "4k": {
      "path": "$values.single.path",
      "output": "$values.single.output",
      "resolution": "2160p"
    },
    "1440p": {
      "path": "$values.single.path",
      "output": "$values.single.output",
      "resolution": "1440p"
    },
    "1440p-slow": {
      "path": "$values.single.path",
      "output": "$values.single.output",
      "resolution": "1440p",
      "limit-rate": "2.5M"
    },
    "playlist": {
      "path": "$values.playlist.path",
      "output": "$values.playlist.output",
      "resolution": "1080p",
      "playlist": true
    }
  },
  "values": {
    "playlist": {
      "path": "/mnt/storage/Storage/YouTube/YouTube Playlists/",
      "output": "%(playlist)s/%(playlist_autonumber|03d)s - %(title)s [%(id)s] [%(uploader)s].%(ext)s"
    },
    "single": {
      "path": "/mnt/storage/Storage/YouTube/YouTube/",
      "output": "%(title)s [%(id)s] [%(uploader)s].%(ext)s"
    },
    "general": {
      "user-agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:147.0) Gecko/20100101 Firefox/147.0",
      "impersonate": "Firefox-147:Macos-26"
    }
  },
  "$defaults": {
    "user-agent": "$values.general.user-agent",
    "impersonate": "$values.general.impersonate"
  }
}
