{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "yt_sql",
      "camelcase": "YtSql",
      "title": "yt-sql",
      "scope": "source.yt-sql",
      "path": ".",
      "file-types": [
        "ytsql"
      ]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "LGPL-2.1-only",
    "description": "Experimental yt-sql grammar for yt-media-tools",
    "authors": [
      {
        "name": "sciguyryan"
      }
    ],
    "links": {
      "repository": "https://github.com/sciguyryan/yt-media-tools"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": true,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
