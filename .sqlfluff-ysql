# YT-SQL extends SQLFluff's SQLite dialect; use the same native layout rules.
[sqlfluff]
dialect = ytsql
templater = raw
sql_file_exts = .ysql
max_line_length = 120
# Unordered LIMIT is valid YT-SQL; this semantic lint exception is intentional.
exclude_rules = LT05, AM09

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4

# Match the established multiline SELECT presentation for both dialects.
[sqlfluff:rules:layout.select_targets]
single_target_policy = new_line
