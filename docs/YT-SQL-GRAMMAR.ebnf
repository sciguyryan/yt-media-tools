(* yt-sql formal grammar draft
 *
 * Parser-neutral EBNF. The accepted syntax surface is now represented here;
 * authority, revisioning and verification are established separately.
 *)

query                 = [ with-clause ], query-expression ;
query-expression      = query-primary, { union-operator, query-primary },
                        [ order-by-clause ], [ limit-clause ], [ offset-clause ] ;
query-primary         = select-query | predicate-only-query | "(", query-expression, ")" ;
predicate-only-query  = boolean-expression ;
union-operator        = "UNION", [ "ALL" ] ;

with-clause           = "WITH", cte, { ",", cte } ;
cte                   = identifier, "AS", "(", query-expression, ")" ;

select-query          = [ select-clause ], [ from-clause ], [ where-clause ],
                        [ group-by-clause ], [ having-clause ] ;
select-clause         = "SELECT", [ "DISTINCT" ], select-term, { ",", select-term } ;
select-term           = relation-wildcard | scalar-expression, [ "AS", identifier ] ;
relation-wildcard     = identifier, ".", "*" ;

from-clause           = "FROM", relation-reference, { join-clause } ;
relation-reference    = relation-source, [ "OF", facet-reference, { ",", facet-reference } ],
                        [ "AS", identifier ] ;
facet-reference       = identifier ;
relation-source       = at-identifier | identifier | string ;
join-clause           = join-kind, relation-reference-single, "ON", boolean-expression ;
join-kind             = [ "INNER" ], "JOIN"
                      | "LEFT", [ "OUTER" ], "JOIN"
                      | "SEMI", "JOIN"
                      | "ANTI", "JOIN" ;
relation-reference-single = relation-source, [ "OF", facet-reference ], [ "AS", identifier ] ;

where-clause          = "WHERE", boolean-expression ;
group-by-clause       = "GROUP", "BY", scalar-expression, { ",", scalar-expression } ;
having-clause         = "HAVING", having-expression ;
order-by-clause       = "ORDER", "BY", order-term, { ",", order-term } ;
order-term            = scalar-expression, [ "ASC" | "DESC" ] ;
limit-clause          = "LIMIT", positive-decimal-integer ;
offset-clause         = "OFFSET", non-negative-decimal-integer ;

boolean-expression    = boolean-and, { "OR", boolean-and } ;
boolean-and           = boolean-not, { "AND", boolean-not } ;
boolean-not           = [ "NOT" ], boolean-primary ;
boolean-primary       = predicate
                      | collection-predicate
                      | "(", boolean-expression, ")",
                        [ truth-test ] ;
collection-predicate  = ( "ANY" | "ALL" ), "(", scalar-expression, "AS", identifier,
                        "WHERE", boolean-expression, ")" ;

predicate             = scalar-expression, predicate-suffix ;
predicate-suffix      = comparison-operator, scalar-expression
                      | [ "NOT" ], "BETWEEN", literal-value, "AND", literal-value
                      | [ "NOT" ], "IN", "(", literal-value, { ",", literal-value }, ")"
                      | [ "NOT" ], "IS", [ "NOT" ], "DISTINCT", "FROM", scalar-expression
                      | [ "NOT" ], "IS", [ "NOT" ], "NULL"
                      | [ "NOT" ], "IS", [ "NOT" ], truth-value
                      | [ "NOT" ], text-operator, text-value
                      | "DOES", "NOT", text-operator, text-value
                      | natural-comparison, literal-value
                      | empty ;
comparison-operator   = "=" | "!=" | "<>" | "<" | "<=" | ">" | ">=" ;
truth-test            = "IS", [ "NOT" ], truth-value ;
truth-value           = "TRUE" | "FALSE" | "UNKNOWN" ;
text-operator         = "CONTAIN" | "CONTAINS" | "MATCH" | "MATCHES" | "LIKE" | "ILIKE" ;
natural-comparison    = "AT", "LEAST" | "AT", "MOST"
                      | "GREATER", "THAN" | "MORE", "THAN" | "LESS", "THAN"
                      | "EQUAL", "TO" | "OVER" | "ABOVE" | "UNDER" | "BELOW" | "EQUALS" ;

having-expression     = having-and, { "OR", having-and } ;
having-and            = having-not, { "AND", having-not } ;
having-not            = [ "NOT" ], having-primary ;
having-primary        = having-predicate, [ truth-test ]
                      | "(", having-expression, ")", [ truth-test ] ;
having-predicate      = scalar-expression,
                        ( comparison-operator, scalar-expression
                        | "IS", [ "NOT" ], "DISTINCT", "FROM", scalar-expression
                        | "IS", [ "NOT" ], "NULL"
                        | "IS", [ "NOT" ], truth-value ) ;

scalar-expression     = additive-expression ;
additive-expression   = multiplicative-expression, { ( "+" | "-" ), multiplicative-expression } ;
multiplicative-expression = unary-expression, { ( "*" | "/" | "%" ), unary-expression } ;
unary-expression      = [ "+" | "-" ], unary-expression | postfix-expression ;
postfix-expression    = scalar-atom, { index-suffix | member-suffix } ;
index-suffix          = "[", scalar-expression, "]" ;
member-suffix         = ".", identifier ;

scalar-atom           = identifier
                      | scalar-literal
                      | scalar-function
                      | aggregate-function
                      | collection-transform
                      | case-expression
                      | "(", scalar-expression, ")" ;
case-expression       = "CASE", case-when, { case-when }, [ "ELSE", scalar-expression ], "END" ;
case-when             = "WHEN", boolean-expression, "THEN", scalar-expression ;

scalar-function       = unary-scalar-function, "(", scalar-expression, ")"
                      | multi-scalar-function, "(", scalar-expression, ",", scalar-expression,
                        { ",", scalar-expression }, ")"
                      | "CHAR", "(", scalar-expression, { ",", scalar-expression }, ")"
                      | "NULLIF", "(", scalar-expression, ",", scalar-expression, ")"
                      | "RANDOM", "(", [ scalar-expression ], ")" ;
unary-scalar-function = "LOWER" | "UPPER" | "LENGTH" | "CARDINALITY" ;
multi-scalar-function = "COALESCE" | "CONCAT" | "GREATEST" | "LEAST" ;
aggregate-function    = "COUNT", "(", ( "*" | scalar-expression
                                      | scalar-expression, "AS", identifier, "WHERE", boolean-expression ), ")",
                        [ aggregate-filter ]
                      | aggregate-name, "(", scalar-expression, ")", [ aggregate-filter ] ;
aggregate-name        = "SUM" | "MIN" | "MAX" | "AVG" ;
aggregate-filter      = "FILTER", "(", "WHERE", boolean-expression, ")" ;
collection-transform  = "FILTER", "(", scalar-expression, "AS", identifier, "WHERE", boolean-expression, ")"
                      | "MAP", "(", scalar-expression, "AS", identifier, "SELECT", scalar-expression, ")" ;

scalar-literal        = number | string | "TRUE" | "FALSE" | "NULL" ;
literal-value         = scalar-literal | identifier | literal-sequence ;
text-value            = string | identifier | number | date-token | datetime-token | time-token | temporal-token ;
literal-sequence      = literal-piece, { literal-piece } ;
literal-piece         = identifier | number | date-token | datetime-token | time-token | temporal-token | "+" | "-" | "*" | "/" | "%" ;

(* Lexical rules. Unicode XID_Start/XID_Continue use the Unicode properties
 * provided by the implementation language, without Unicode normalisation. *)
identifier            = ordinary-identifier | quoted-identifier ;
ordinary-identifier   = xid-start, { xid-continue | "-" }, { ".", xid-start, { xid-continue | "-" } } ;
quoted-identifier     = "`", quoted-identifier-character, { quoted-identifier-character }, "`" ;
at-identifier         = "@", ascii-source-character, { ascii-source-character } ;

number                = decimal-number | hexadecimal-integer | octal-integer | binary-integer ;
decimal-number        = decimal-digits, [ ".", decimal-digits ], [ magnitude-suffix ] ;
magnitude-suffix      = "k" | "K" | "m" | "M" | "b" | "B" ;
hexadecimal-integer   = "0x", base16-digits ;
octal-integer         = "0o", base8-digits ;
binary-integer        = "0b", base2-digits ;
positive-decimal-integer = decimal-digits ;
non-negative-decimal-integer = decimal-digits ;

string                = single-quoted-string | double-quoted-string ;
temporal-token        = today-or-now, [ signed-unit-quantity ] ;
today-or-now          = "TODAY()" | "NOW()" ;
infinity-token        = "INFINITY()" | "-INFINITY()" ;

(* DATE, DATETIME and TIME token shapes, numeric digit/separator validity,
 * string escapes, parameter substitution, field-aware temporal collection,
 * reserved/contextual keyword classification and malformed-token rejection are
 * lexical contracts defined in docs/YT-SQL.md and docs/YT-SQL-DIAGNOSTICS.md.
 * Parameters are substituted before parsing and therefore are not AST grammar. *)

empty                 = ;
