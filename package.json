{
  "name": "yt-media-tools",
  "private": true,
  "description": "Optional Node.js dependencies for yt-discover acquisition backends.",
  "dependencies": {
    "youtubei.js": "18.0.0"
  },
  "scripts": {
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\" \"!.venv/**\"",
    "tree-sitter:generate": "cd experiments/tree-sitter-yt-sql && tree-sitter generate --abi 15",
    "tree-sitter:test": "cd experiments/tree-sitter-yt-sql && tree-sitter test",
    "tree-sitter:update": "cd experiments/tree-sitter-yt-sql && tree-sitter test --update",
    "format:tree-sitter": "./scripts/lint-tree-sitter.sh --format",
    "lint:tree-sitter:format": "./scripts/lint-tree-sitter.sh --check-format",
    "lint:tree-sitter:native": "./scripts/lint-tree-sitter.sh --lint",
    "lint:tree-sitter:generated": "./scripts/lint-tree-sitter.sh --check-generated",
    "lint:tree-sitter": "./scripts/lint-tree-sitter.sh --check"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.2",
    "tree-sitter-cli": "0.26.13"
  },
  "allowScripts": {
    "tree-sitter-cli@0.26.13": true
  }
}
