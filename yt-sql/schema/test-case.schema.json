{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YT-SQL portable test case",
  "type": "object",
  "required": [
    "version",
    "id",
    "datasets",
    "query",
    "expected",
    "order"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "query": {
      "const": "query.sql"
    },
    "expected": {
      "const": "expected.json"
    },
    "order": {
      "enum": [
        "ordered",
        "unordered",
        "tied"
      ]
    },
    "parameters": {
      "type": "object",
      "description": "Named, case-sensitive bindings. Missing names are distinct from names bound to null. Values use the portable typed-value contract.",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "execution": {
      "type": "object",
      "required": [
        "configurations"
      ],
      "properties": {
        "configurations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "settings"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "settings": {
                "type": "object",
                "properties": {
                  "optimisation": {
                    "enum": [
                      "enabled",
                      "disabled"
                    ]
                  },
                  "clock": {
                    "type": "string",
                    "description": "Offset-aware RFC 3339 timestamp used as the query clock.",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "group_sizes": {
      "type": "array",
      "description": "Sizes of consecutive equal-ordering-key groups, established from independently reviewed ordering expressions.",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://yt-sql.local/schema/test-case.schema.json",
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "timestamp"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "order": {
            "const": "tied"
          }
        }
      },
      "then": {
        "required": [
          "group_sizes"
        ]
      },
      "else": {
        "not": {
          "required": [
            "group_sizes"
          ]
        }
      }
    }
  ]
}
