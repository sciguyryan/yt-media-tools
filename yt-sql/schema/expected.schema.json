{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YT-SQL expected observable result",
  "type": "object",
  "required": [
    "version",
    "outcome"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "outcome": {
      "enum": [
        "rows",
        "error"
      ]
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "syntax",
            "resolution",
            "type",
            "evaluation",
            "unsupported",
            "parameter"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$id": "https://yt-sql.local/schema/expected.schema.json",
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "rows"
        }
      },
      "required": [
        "columns",
        "rows"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "error"
        }
      },
      "required": [
        "error"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "columns"
            ]
          },
          {
            "required": [
              "rows"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "decimal"
            },
            "value": {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "timestamp"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
