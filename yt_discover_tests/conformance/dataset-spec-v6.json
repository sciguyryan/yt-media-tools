{
  "kind": "yt-sql-conformance-generator-specification",
  "generator_version": 6,
  "default_seed": 31415926,
  "profiles": {
    "small": 60,
    "normal": 1000,
    "large": 10000,
    "huge": 100000
  },
  "source_handle": "@yt_sql_fixture",
  "source_url": "https://www.youtube.com/@yt_sql_fixture/videos",
  "purpose": "Deterministic extractor-like scalar, collection and structured metadata generated ephemerally for independent yt-sql semantic conformance, stress and performance testing.",
  "determinism_contract": "For a fixed generator version, seed and requested size, the logical record sequence is identical. Smaller datasets are exact prefixes of larger datasets for the same version and seed.",
  "required_edge_classes": [
    "same-day uploads",
    "identical timestamps",
    "NULL timestamps",
    "NULL numeric values",
    "duration boundary values",
    "duplicate projected values",
    "case-variant titles",
    "regex metacharacters",
    "Unicode text",
    "canonically equivalent but byte-distinct Unicode text",
    "combining marks and grapheme clusters",
    "supplementary-plane characters",
    "emoji and zero-width joiner sequences",
    "Unicode case-mapping edge cases",
    "right-to-left and bidirectional marks",
    "Unicode whitespace and line separators",
    "large integer counts",
    "availability states",
    "live-state booleans",
    "dynamic raw scalar fields",
    "typed scalar collection fields",
    "NULL collection values",
    "out-of-range collection indexing",
    "dynamic raw ordered collections",
    "first-class structured metadata collections",
    "dynamic raw structured records",
    "dynamic raw nested structured members",
    "dynamic raw structured record collections",
    "missing and NULL dynamic structured members",
    "stable source ordering",
    "controlled repeated categorical values",
    "multiple synthetic channel identities",
    "empty collection values",
    "nullable collection elements",
    "collection predicate true false and unknown outcomes",
    "collection filter and projection composition",
    "nested collection element scopes"
  ]
}
