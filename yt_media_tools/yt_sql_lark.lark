// Experimental Lark grammar for yt-sql grammar revision 1.
// The authoritative language grammar remains docs/YT-SQL-GRAMMAR.ebnf.
//
// This transcription follows the reconciled revision-1 EBNF.
//
// Note: I really... really... need to optimise this. It is a true horror
// and will be a nightmare to maintain in its current form. Eww.

?start: query
query: with_clause? query_expression
query_expression: query_primary (union_operator query_primary)* order_by_clause? limit_clause? offset_clause?
?query_primary: select_query | predicate_only_query | "(" query_expression ")"
predicate_only_query: boolean_expression
union_operator: _UNION _ALL?

with_clause: _WITH cte ("," cte)*
cte: identifier _AS "(" query_expression ")"

select_query: select_clause from_clause? where_clause? group_by_clause? having_clause?
            | from_clause where_clause? group_by_clause? having_clause?
            | where_clause group_by_clause? having_clause?
            | group_by_clause having_clause?
            | having_clause
select_clause: _SELECT _DISTINCT? select_term ("," select_term)*
select_term: projection_wildcard | relation_wildcard | scalar_expression (_AS identifier)?
projection_wildcard: "*"
relation_wildcard: identifier "." "*"

from_clause: _FROM relation_reference join_clause*
relation_reference: relation_source (_OF facet_reference ("," facet_reference)*)? (_AS identifier)?
facet_reference: identifier
?relation_source: AT_IDENTIFIER | identifier | STRING
join_clause: join_kind relation_reference_single _ON boolean_expression
join_kind: _INNER? _JOIN | _LEFT _OUTER? _JOIN | _SEMI _JOIN | _ANTI _JOIN
relation_reference_single: relation_source (_OF facet_reference)? (_AS identifier)?

where_clause: _WHERE boolean_expression
group_by_clause: _GROUP _BY scalar_expression ("," scalar_expression)*
having_clause: _HAVING having_expression
order_by_clause: _ORDER _BY order_term ("," order_term)*
order_term: scalar_expression (_ASC | _DESC)?
limit_clause: _LIMIT DECIMAL_INTEGER
offset_clause: _OFFSET DECIMAL_INTEGER

?boolean_expression: boolean_and (_OR boolean_and)*
?boolean_and: boolean_not (_AND boolean_not)*
boolean_not: _NOT boolean_not | boolean_primary
?boolean_primary: predicate | collection_predicate | "(" boolean_expression ")" truth_test?
collection_predicate: (_ANY | _ALL) "(" scalar_expression _AS identifier _WHERE boolean_expression ")"

predicate: scalar_expression predicate_suffix
?predicate_suffix: comparison_operator comparison_value
                 | _NOT? _BETWEEN literal_value _AND literal_value
                 | _NOT? _IN "(" literal_value ("," literal_value)* ")"
                 | _NOT? _IS _NOT? _DISTINCT _FROM scalar_expression
                 | _NOT? _IS _NOT? _NULL
                 | _NOT? _IS _NOT? truth_value
                 | _NOT? text_operator text_value
                 | _DOES _NOT text_operator text_value
                 | natural_comparison literal_value
                 |
comparison_operator: "=" | "!=" | "<>" | "<" | "<=" | ">" | ">="
?comparison_value: temporal_literal | literal_sequence | scalar_expression
truth_test: _IS _NOT? truth_value
truth_value: _TRUE | _FALSE | _UNKNOWN
text_operator: _CONTAIN | _CONTAINS | _MATCH | _MATCHES | _LIKE | _ILIKE
natural_comparison: _AT _LEAST | _AT _MOST | _GREATER _THAN | _MORE _THAN | _LESS _THAN | _EQUAL _TO | _OVER | _ABOVE | _UNDER | _BELOW | _EQUALS

?having_expression: having_and (_OR having_and)*
?having_and: having_not (_AND having_not)*
having_not: _NOT? having_primary
?having_primary: having_predicate truth_test? | "(" having_expression ")" truth_test?
having_predicate: scalar_expression (comparison_operator scalar_expression | _IS _NOT? _DISTINCT _FROM scalar_expression | _IS _NOT? _NULL | _IS _NOT? truth_value)

?scalar_expression: additive_expression
?additive_expression: multiplicative_expression (("+" | "-") multiplicative_expression)*
?multiplicative_expression: unary_expression (("*" | "/" | "%") unary_expression)*
?unary_expression: UNARY_OPERATOR unary_expression | postfix_expression
?postfix_expression: scalar_atom (index_suffix | member_suffix)*
index_suffix: "[" scalar_expression "]"
member_suffix: "." identifier

?scalar_atom: identifier | scalar_literal | scalar_function | aggregate_function | collection_transform | case_expression | "(" scalar_expression ")"
case_expression: _CASE case_when+ (_ELSE scalar_expression)? _END
case_when: _WHEN boolean_expression _THEN scalar_expression

scalar_function: unary_scalar_function "(" scalar_expression ")"
               | multi_scalar_function "(" scalar_expression "," scalar_expression ("," scalar_expression)* ")"
               | _CHAR "(" scalar_expression ("," scalar_expression)* ")"
               | _NULLIF "(" scalar_expression "," scalar_expression ")"
               | _RANDOM "(" scalar_expression? ")"
unary_scalar_function: _LOWER | _UPPER | _LENGTH | _CARDINALITY
multi_scalar_function: _COALESCE | _CONCAT | _GREATEST | _LEAST
aggregate_function: _COUNT "(" ("*" | scalar_expression | scalar_expression _AS identifier _WHERE boolean_expression) ")" aggregate_filter?
                  | aggregate_name "(" scalar_expression ")" aggregate_filter?
aggregate_name: _SUM | _MIN | _MAX | _AVG
aggregate_filter: _FILTER "(" _WHERE boolean_expression ")"
collection_transform: _FILTER "(" scalar_expression _AS identifier _WHERE boolean_expression ")"
                    | _MAP "(" scalar_expression _AS identifier _SELECT scalar_expression ")"

scalar_literal: UNIT_LITERAL | NUMBER | STRING | _TRUE | _FALSE | _NULL
temporal_literal: INFINITY | TEMPORAL | DATETIME | DATE | TIME
?literal_value: scalar_literal | temporal_literal | identifier | literal_sequence
?text_value: STRING | identifier | UNIT_LITERAL | NUMBER | DATE | DATETIME | TIME | TEMPORAL
literal_sequence: literal_piece+
?literal_piece: identifier | UNIT_LITERAL | NUMBER | DATE | DATETIME | TIME | TEMPORAL | "+" | "-" | "*" | "/" | "%"

?identifier: IDENTIFIER | QUOTED_IDENTIFIER

// Structural words are contextual, but may not be consumed as prefixes of an
// ordinary identifier. Leading underscores keep these terminals out of the
// parser tree consumed by the experimental model builder.
_ABOVE: /(?i:ABOVE)(?![\w-])/u
_ALL: /(?i:ALL)(?![\w-])/u
_AND: /(?i:AND)(?![\w-])/u
_ANTI: /(?i:ANTI)(?![\w-])/u
_ANY: /(?i:ANY)(?![\w-])/u
_AS: /(?i:AS)(?![\w-])/u
_ASC: /(?i:ASC)(?![\w-])/u
_AT: /(?i:AT)(?![\w-])/u
_AVG: /(?i:AVG)(?![\w-])/u
_BELOW: /(?i:BELOW)(?![\w-])/u
_BETWEEN: /(?i:BETWEEN)(?![\w-])/u
_BY: /(?i:BY)(?![\w-])/u
_CARDINALITY: /(?i:CARDINALITY)(?![\w-])/u
_CASE: /(?i:CASE)(?![\w-])/u
_CHAR: /(?i:CHAR)(?![\w-])/u
_COALESCE: /(?i:COALESCE)(?![\w-])/u
_CONCAT: /(?i:CONCAT)(?![\w-])/u
_CONTAIN: /(?i:CONTAIN)(?![\w-])/u
_CONTAINS: /(?i:CONTAINS)(?![\w-])/u
_COUNT: /(?i:COUNT)(?![\w-])/u
_DESC: /(?i:DESC)(?![\w-])/u
_DISTINCT: /(?i:DISTINCT)(?![\w-])/u
_DOES: /(?i:DOES)(?![\w-])/u
_ELSE: /(?i:ELSE)(?![\w-])/u
_END: /(?i:END)(?![\w-])/u
_EQUAL: /(?i:EQUAL)(?![\w-])/u
_EQUALS: /(?i:EQUALS)(?![\w-])/u
_FALSE: /(?i:FALSE)(?![\w-])/u
_FILTER: /(?i:FILTER)(?![\w-])/u
_FROM: /(?i:FROM)(?![\w-])/u
_GREATER: /(?i:GREATER)(?![\w-])/u
_GREATEST: /(?i:GREATEST)(?![\w-])/u
_GROUP: /(?i:GROUP)(?![\w-])/u
_HAVING: /(?i:HAVING)(?![\w-])/u
_ILIKE: /(?i:ILIKE)(?![\w-])/u
_IN: /(?i:IN)(?![\w-])/u
_INNER: /(?i:INNER)(?![\w-])/u
_IS: /(?i:IS)(?![\w-])/u
_JOIN: /(?i:JOIN)(?![\w-])/u
_LEAST: /(?i:LEAST)(?![\w-])/u
_LEFT: /(?i:LEFT)(?![\w-])/u
_LENGTH: /(?i:LENGTH)(?![\w-])/u
_LESS: /(?i:LESS)(?![\w-])/u
_LIKE: /(?i:LIKE)(?![\w-])/u
_LIMIT: /(?i:LIMIT)(?![\w-])/u
_LOWER: /(?i:LOWER)(?![\w-])/u
_MAP: /(?i:MAP)(?![\w-])/u
_MATCH: /(?i:MATCH)(?![\w-])/u
_MATCHES: /(?i:MATCHES)(?![\w-])/u
_MAX: /(?i:MAX)(?![\w-])/u
_MIN: /(?i:MIN)(?![\w-])/u
_MORE: /(?i:MORE)(?![\w-])/u
_MOST: /(?i:MOST)(?![\w-])/u
_NOT: /(?i:NOT)(?![\w-])/u
_NULL: /(?i:NULL)(?![\w-])/u
_NULLIF: /(?i:NULLIF)(?![\w-])/u
_OF: /(?i:OF)(?![\w-])/u
_OFFSET: /(?i:OFFSET)(?![\w-])/u
_ON: /(?i:ON)(?![\w-])/u
_OR: /(?i:OR)(?![\w-])/u
_ORDER: /(?i:ORDER)(?![\w-])/u
_OUTER: /(?i:OUTER)(?![\w-])/u
_OVER: /(?i:OVER)(?![\w-])/u
_RANDOM: /(?i:RANDOM)(?![\w-])/u
_SELECT: /(?i:SELECT)(?![\w-])/u
_SEMI: /(?i:SEMI)(?![\w-])/u
_SUM: /(?i:SUM)(?![\w-])/u
_THAN: /(?i:THAN)(?![\w-])/u
_THEN: /(?i:THEN)(?![\w-])/u
_TO: /(?i:TO)(?![\w-])/u
_TRUE: /(?i:TRUE)(?![\w-])/u
_UNDER: /(?i:UNDER)(?![\w-])/u
_UNION: /(?i:UNION)(?![\w-])/u
_UNKNOWN: /(?i:UNKNOWN)(?![\w-])/u
_UPPER: /(?i:UPPER)(?![\w-])/u
_WHEN: /(?i:WHEN)(?![\w-])/u
_WHERE: /(?i:WHERE)(?![\w-])/u
_WITH: /(?i:WITH)(?![\w-])/u

AT_IDENTIFIER: /@[A-Za-z0-9_.-]+/
QUOTED_IDENTIFIER: /`(?:``|[^`])+`/
IDENTIFIER: /[^\W\d][\w-]*(?:\.[^\W\d][\w-]*)*/u
UNIT_LITERAL: /\d+(?:\.\d+)?[^\W\d_]+(?:-[^\W\d_]+)*(?:\d+(?:\.\d+)?[^\W\d_]+(?:-[^\W\d_]+)*)*/u
NUMBER: /(?:0[xX][0-9A-Za-z_]+|0[oO][0-9A-Za-z_]+|0[bB][0-9A-Za-z_]+|\d[\d_]*(?:\.\d[\d_]*)?(?:[kKmMbB])?)/
DECIMAL_INTEGER: /\d[\d_]*/
STRING: /'(?:''|\\.|[^'\\])*'|"(?:""|\\.|[^"\\])*"/
INFINITY.4: /(?i:-?INFINITY\(\))/
TEMPORAL.4: /(?i:TODAY|NOW)\(\)(?:\s*[+-]\s*\d+(?:\.\d+)?\s*[^\W\d_]+(?:-[^\W\d_]+)*)?/
DATETIME.3: /\d{4}-\d{1,2}-\d{1,2}T\d{1,2}:\d{2}(?::\d{2}(?:\.\d+)?)?(?:Z|[+-]\d{2}:?\d{2})?/
DATE.2: /\d{4}[-\/.]\d{1,2}[-\/.]\d{1,2}|\d{1,2}[-\/.]\d{1,2}[-\/.]\d{4}/
TIME.2: /\d{1,3}:\d{1,2}(?::\d{1,2})?/
UNARY_OPERATOR: "+" | "-"

%import common.WS
%ignore WS
